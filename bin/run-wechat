#!/usr/bin/env bash
# Foreground runner for supervisor: WeChat sidecar
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

export PATH="/root/.nvm/versions/node/v20.19.4/bin:$PATH"

set -a
# shellcheck disable=SC1091
source "$ROOT_DIR/conf/.env"
set +a
export WECHAT_ACCOUNT_PATH="${WECHAT_ACCOUNT_PATH:-$ROOT_DIR/conf/wechat/account.json}"
export WECHAT_SYNC_BUF_PATH="${WECHAT_SYNC_BUF_PATH:-$ROOT_DIR/runtime/wechat/get_updates_buf.txt}"

if [[ ! -f "$WECHAT_ACCOUNT_PATH" ]]; then
  echo "[ERROR] WeChat 未登录（缺少 $WECHAT_ACCOUNT_PATH），请先执行 ./bin/server wx login"
  exit 1
fi

exec node "$ROOT_DIR/lib/js/wechat-sidecar.mjs" run
