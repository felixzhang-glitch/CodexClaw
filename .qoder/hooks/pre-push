#!/usr/bin/env bash
# codeClaw pre-push 密钥扫描钩子。
# 由 .git/hooks/pre-push 转发调用；真实逻辑在 secret_scan.py。
#
# stdin 每行格式：<local_ref> <local_sha> <remote_ref> <remote_sha>
# 策略：fail-closed —— 扫描器命中或自身异常都阻断推送。

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCANNER="$HOOK_DIR/secret_scan.py"
ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

if [ "${SKIP_SECRET_SCAN:-0}" = "1" ]; then
  echo "" >&2
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
  echo "!! SKIP_SECRET_SCAN=1 已跳过密钥扫描，请自行确认本次推送内容无敏感信息 !!" >&2
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
  echo "" >&2
  exit 0
fi

if [ ! -f "$SCANNER" ]; then
  echo "[secret-scan] 找不到扫描器 $SCANNER，阻断推送" >&2
  exit 1
fi

PYTHON_BIN="$(command -v python3 || true)"
if [ -z "$PYTHON_BIN" ]; then
  echo "[secret-scan] 未找到 python3，无法执行密钥扫描，阻断推送" >&2
  echo "[secret-scan] 确认无风险可临时使用：SKIP_SECRET_SCAN=1 git push ..." >&2
  exit 1
fi

status=0
scanned=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue

  # 删除远端分支：无新增内容
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi

  # 先把远端 ref 同步到本地，让 merge-base 能找到远端提交。远端被 rebase 后
  # remote_sha 往往不在本地仓库，直接拿来当 base 会让 git diff 报 bad object。
  if [ -n "$remote_ref" ] && [ "$remote_ref" != "$ZERO" ]; then
    git fetch --quiet --no-tags "$remote_ref" "$remote_ref" 2>/dev/null || true
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    # 新分支：优先与远端默认分支求 merge-base，失败回退空树（等价全量扫该分支）
    base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)"
    if [ -z "$base" ]; then
      base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    fi
    if [ -z "$base" ]; then
      base="$(git merge-base "$local_sha" origin/master 2>/dev/null || true)"
    fi
    [ -z "$base" ] && base="$EMPTY_TREE"
  else
    # 远端 SHA 在本地仓库（fetch 后）就用 merge-base 精确找共同祖先；
    # 否则回退到远端跟踪分支或空树，保证 git diff 不会报 bad object。
    base="$(git merge-base "$local_sha" "$remote_sha" 2>/dev/null || true)"
    if [ -z "$base" ] && git rev-parse --verify -q "$remote_ref" >/dev/null 2>&1; then
      base="$(git merge-base "$local_sha" "$remote_ref" 2>/dev/null || true)"
    fi
    [ -z "$base" ] && base="$EMPTY_TREE"
  fi

  scanned=1
  "$PYTHON_BIN" "$SCANNER" --range "${base}..${local_sha}" --quiet
  rc=$?
  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -ge 2 ]; then
      echo "[secret-scan] 扫描器异常退出（code=$rc），按阻断处理" >&2
    fi
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "[secret-scan] 推送已被阻断（ref 扫描未通过）" >&2
  exit 1
fi

if [ "$scanned" = "1" ]; then
  echo "[secret-scan] 密钥扫描通过，继续推送"
fi

exit 0
