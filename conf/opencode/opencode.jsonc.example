{
  "$schema": "https://opencode.ai/config.json",
  // 注册百炼上有但 opencode 模型注册表未收录的模型，供 --model 引用
  // 复制到 ~/.config/opencode/opencode.jsonc 生效（与 codeClaw 经 OPENCODE_CONFIG_CONTENT
  // 注入的 permission/instructions/plugin 是合并关系，不会互相覆盖）
  "provider": {
    "alibaba-cn": {
      "models": {
        "glm-5.2-fast-preview": {
          "name": "GLM 5.2 Fast Preview"
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          // reasoning=true 让 opencode 给百炼请求带上 enable_thinking，
          // 思考走 reasoning_content，不会混进正文
          "reasoning": true,
          // 百炼 low/medium 等效 high、xhigh 等效 max，实际只有两档；
          // 这里写 high 即默认档，要加深推理才需要改 max
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
