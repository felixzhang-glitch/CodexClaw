# Feishu credentials (required)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional callback verification settings
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_GROUP_REQUIRE_MENTION=true
FEISHU_MAX_RETRIES=2
FEISHU_RETRY_BACKOFF_SECONDS=0.5
FEISHU_RECEIVED_IMAGES_DIR=./runtime/feishu-images

# Codex backend (local codex CLI)
CODEX_CLI_BIN=codex
CODEX_WORK_DIR=./runtime/codex-workdir
CODEX_GENERATED_IMAGES_DIR=~/.codex/generated_images
CODEX_MODEL=
CODEX_PERMISSION_MODE=full
CODEX_TIMEOUT_SECONDS=30
CODEX_STREAM_READ_LIMIT_BYTES=262144
CODEX_MAX_RETRIES=2
CODEX_RETRY_BACKOFF_SECONDS=1.0
CODEX_CIRCUIT_BREAKER_THRESHOLD=5
CODEX_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Backend routing (switch via /codex /claude /qodercli; query via /backend)
ACTIVE_BACKEND=codex
BACKEND_STATE_PATH=./runtime/server/backend.json
# Claude Code CLI (auto = max permission under root; dangerously-skip-permissions is rejected)
CLAUDE_CLI_BIN=claude
CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=auto
CLAUDE_TIMEOUT_SECONDS=60
# Qoder CLI (Claude Code family; dangerously-skip-permissions works under root)
QODERCLI_CLI_BIN=qodercli
QODERCLI_MODEL=
QODERCLI_PERMISSION_MODE=dangerously-skip-permissions
QODERCLI_TIMEOUT_SECONDS=60

# Optional legacy HTTP fields (unused in CLI mode)
CODEX_API_BASE=https://api.openai.com/v1
CODEX_API_KEY=

# Runtime behavior
MAX_HISTORY_ROUNDS=10
STREAMING_ENABLED=true
TASK_RUNNING_NOTICE_SECONDS=30
FEISHU_MESSAGE_CHUNK_CHARS=120
FEISHU_STREAM_FLUSH_SECONDS=1.0
WECHAT_WEBHOOK_TOKEN=
WECHAT_MESSAGE_CHUNK_CHARS=1800
DEDUPLICATE_TTL_SECONDS=3600
REMINDER_STORE_PATH=./runtime/server/reminders.json

# Server & logging
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO
